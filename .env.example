# Supabase browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential; never prefix this with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only CreateOS and agent model provider credentials
CREATEOS_SANDBOX_API_KEY=
AGENT_API_KEY=
AGENT_MODEL=

# Test-mode Stripe one-time Checkout (server-only; live keys are rejected)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PRICE_ID=
STRIPE_TEST_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
